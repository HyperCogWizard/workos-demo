<main class="content">
  <form action="/portal" method="POST">
    <fieldset class="form-info">
      <h2 class="form-info__title">Admin Settings</h2>
          <div class="input-field">
            <label class="label">Single Sign-On</label>

            <input hidden class="hidden-field" id="organization-sso" name="organization" type="text" readonly value="<%= @organization.id %>">
            <input hidden class="hidden-field" id="intent-sso" name="intent" type="text" readonly value="sso">

            <button class="button-sso" type="submit">Configure SSO</button>
          </div>
        </div>
    </fieldset>
  </form>

  <form action="/portal" method="POST">
    <fieldset class="form-info" style="margin-top: 20px;">

      <div class="input-field">
        <label class="label">Directory Sync</label>

        <input hidden class="hidden-field" id="organization-dsync" name="organization" type="text" readonly value="<%= @organization.id %>">
        <input hidden class="hidden-field" id="intent-dsync" name="intent" type="text" readonly value="dsync">

        <button class="button-sso" type="submit">Configure Directory Sync</button>
      </div>
    </fieldset>
  </form>

  <form action="/portal" method="POST">
    <fieldset class="form-info" style="margin-top: 20px;">

      <div class="input-field">
        <label class="label">Audit Logs</label>

        <input hidden class="hidden-field" id="organization-audit-logs" name="organization" type="text" readonly value="<%= @organization.id %>">
        <input hidden class="hidden-field" id="intent-audit-logs" name="intent" type="text" readonly value="audit_logs">

        <button class="button-sso" type="submit">View Audit Logs</button>
      </div>
    </fieldset>
  </form>
  
  <!-- Robotics Workbench Integration -->
  <div class="workbench-integration" style="margin-top: 40px; padding: 24px; background: #f9f9f9; border-radius: 8px; border-left: 4px solid #59c197;">
    <h2 style="margin-bottom: 16px; color: #373737;">🤖 Marduk's Robotics Lab</h2>
    <p style="color: #666; margin-bottom: 16px; line-height: 1.5;">
      Extend your enterprise workflow with advanced robotics engineering capabilities. 
      Our neural-symbolic middleware provides GGUF-based tensor serialization, 
      distributed agentic cognition, and HomeAssistant automation kernelization.
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      <a href="/workbench" style="text-decoration: none;">
        <button style="background: #59c197; padding: 12px 20px; border-radius: 6px; color: white; font-weight: 600;">
          Launch Robotics Workbench
        </button>
      </a>
      <a href="/homeassistant" style="text-decoration: none;">
        <button style="background: #f2ca7a; padding: 12px 20px; border-radius: 6px; color: #373737; font-weight: 600;">
          View Cognitive Kernels
        </button>
      </a>
      <button onclick="window.open('/gguf/export/full_lab', '_blank')" style="background: #83b5db; padding: 12px 20px; border-radius: 6px; color: white; font-weight: 600;">
        Export GGUF State
      </button>
    </div>
  </div>
</main>
